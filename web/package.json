{
  "name": "ymcp-creative-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:bench:bootstrap": "BENCH_BOOTSTRAP=true npx vitest run --config vitest.bench.config.ts src/features/novel/__tests__/bench/bench-bootstrap.test.ts",
    "test:bench:draft": "BENCH_STAGE=draft npx vitest run --config vitest.bench.config.ts src/features/novel/__tests__/bench/bench-draft.test.ts",
    "test:bench:review": "BENCH_STAGE=review npx vitest run --config vitest.bench.config.ts src/features/novel/__tests__/bench/bench-review.test.ts",
    "test:bench:revision": "BENCH_STAGE=revision npx vitest run --config vitest.bench.config.ts src/features/novel/__tests__/bench/bench-revision.test.ts",
    "test:bench:smoke": "BENCH_SMOKE=true npx vitest run --config vitest.bench.config.ts src/features/novel/__tests__/bench/bench-smoke.test.ts",
    "test:e2e:foundation": "npx vitest run --config vitest.e2e.config.ts src/features/novel/__tests__/e2e-foundation.test.ts",
    "test:e2e:chapter1": "npx vitest run --config vitest.e2e.config.ts src/features/novel/__tests__/e2e-chapter1.test.ts",
    "bench:compare": "node scripts/novel-bench/compare.mjs",
    "novel:closed-loop": "node scripts/novel-bench/run-closed-loop.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tanstack/react-query": "^5.62.0",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-character-count": "^3.27.3",
    "@tiptap/extension-collaboration": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@tiptap/y-tiptap": "^3.0.6",
    "ajv": "^8.20.0",
    "antd": "^5.22.0",
    "axios": "^1.7.9",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.2.6",
    "minisearch": "^7.2.0",
    "motion": "^12.42.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "y-indexeddb": "^9.0.12",
    "yaml": "^2.9.0",
    "yjs": "^13.6.31",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
