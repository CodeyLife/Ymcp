# Optional build-time shared browser credential for the default API endpoint.
# VITE_* values are embedded in the client bundle and are not server-side secrets.
VITE_DEFAULT_API_KEY=

# Optional localhost bridge used by the external novel-workflow MCP server.
VITE_YMCP_MCP_BRIDGE_ENABLED=false
VITE_YMCP_MCP_BRIDGE_URL=ws://127.0.0.1:4765
VITE_YMCP_MCP_TOKEN=
