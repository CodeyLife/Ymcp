# Optional default credential shared by the browser build and local novel runtime.
# VITE_* values are embedded in the client bundle, so use .env.local only for local development.
# The runtime also persists credentials submitted through Settings in its private secrets file.
VITE_DEFAULT_API_KEY=

# Optional localhost bridge used by the external novel-workflow MCP server.
VITE_YMCP_MCP_BRIDGE_ENABLED=false
VITE_YMCP_MCP_BRIDGE_URL=ws://127.0.0.1:4765
VITE_YMCP_MCP_TOKEN=
